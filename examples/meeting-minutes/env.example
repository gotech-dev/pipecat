# Gladia API Configuration (màn hình /meeting cũ - dịch realtime)
GLADIA_API_KEY=your_gladia_api_key_here
GLADIA_REGION=us-west
# Options: us-west, eu-west

# Speechmatics API Configuration (màn hình /minutes mới - tách người nói tiếng Việt)
# Đăng ký tại https://portal.speechmatics.com
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# Google Gemini API (sinh biên bản AI tóm tắt cuối cuộc họp - rẻ)
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
MINUTES_SUMMARY_MODEL=gemini-2.5-flash

# AI Nội bộ - ASR GoTech (nemotron-asr qua LiteLLM gateway)
# Chế độ "AI Nội bộ" trên màn /minutes. KHÔNG tách người nói (no diarization).
# Xem ASR_GOTECH_INTEGRATION.md. base_url/model có default, thường chỉ cần key.
GOTECH_ASR_API_KEY=your_master_or_team_key_here
GOTECH_ASR_BASE_URL=https://gateway.gotechjsc.com/v1
GOTECH_ASR_MODEL=nemotron-asr

